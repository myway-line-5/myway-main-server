# 서버 간 공유 Bearer 토큰 (필수 — 없으면 서버 시작 실패)
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVER_AUTH_TOKEN=

# AI 서비스 주소 (필수 — http/https만 허용)
# 메인 서버도 8000 포트를 쓰므로 로컬에서 동시 실행 시 AI 포트는 다르게 지정
AI_SERVER_BASE_URL=http://127.0.0.1:8000

# AI 해석 타임아웃(초) — 기본 25 = AI 처리 예산 20초 + 여유
AI_INTERPRET_TIMEOUT_SECONDS=25

# AI 응답 X-AI-Provider 기대 모드 (mock=모의 시험, gemini=실제 연동). 불일치 시 조건 미반영
MYWAY_EXPECTED_AI_PROVIDER=mock

# 메인 DB 파일 경로
MYWAY_DB_PATH=myway.db

# 세션 TTL(초, 기본 3600)
# SESSION_TTL_SECONDS=3600
